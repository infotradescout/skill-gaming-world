{
  "name": "skill-gaming-world",
  "version": "0.1.0",
  "private": true,
  "engines": {
    "node": "22.x"
  },
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "build:verify": "DEMO_MODE=false DATABASE_URL=postgresql://build:build@127.0.0.1:5432/build SESSION_SECRET=build-verification-only-session-secret-32 COMPETITION_SEED_ENCRYPTION_KEY=build-verification-only-ranked-seed-key-32 PREVIEW_OWNER_EMAIL=owner@example.com next build",
    "start": "next start",
    "lint": "eslint .",
    "typecheck": "tsc --noEmit",
    "audit": "npm audit --audit-level=high",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:e2e": "playwright test",
    "test:e2e:configured-preview": "playwright test --config=playwright.configured-preview.ts",
    "check": "npm run audit && npm run lint && npm run typecheck && npm run test && npm run build:verify",
    "db:generate": "drizzle-kit generate",
    "db:migrate": "drizzle-kit migrate",
    "db:studio": "drizzle-kit studio"
  },
  "dependencies": {
    "drizzle-orm": "^0.45.2",
    "next": "16.2.12",
    "postgres": "^3.4.9",
    "react": "19.2.8",
    "react-dom": "19.2.4",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@electric-sql/pglite": "^0.3.14",
    "@playwright/test": "^1.62.0",
    "@types/node": "^20",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "drizzle-kit": "^0.31.10",
    "eslint": "^9.39.5",
    "eslint-config-next": "16.2.12",
    "tsx": "^4.23.1",
    "typescript": "^5",
    "vitest": "^4.1.10"
  },
  "overrides": {
    "brace-expansion": "5.0.8",
    "esbuild": "0.28.1",
    "minimatch": "10.2.5",
    "postcss": "8.5.23",
    "sharp": "0.35.3"
  }
}

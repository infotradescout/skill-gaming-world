# This source is embedded, in plain text, in the downloadable START-WILDLIFE.cmd.
# The publisher replaces exactly three placeholders with a pinned immutable kit.
$ErrorActionPreference = 'Stop'
Set-StrictMode -Version 2.0
$KitUrl = '@@KIT_URL@@'
$KitSha = '@@KIT_SHA@@'
$KitBytes = @@KIT_BYTES@@
$archive = $null
$downloadLock = $null
$attempt = $null
function Expand-WildlifeZip {
    param([string]$Zip, [string]$Destination)
    Add-Type -AssemblyName System.IO.Compression.FileSystem
    if (Test-Path -LiteralPath $Destination) { throw 'Refusing to overwrite an existing build attempt.' }
    New-Item -ItemType Directory -Path $Destination | Out-Null
    $root = [IO.Path]::GetFullPath($Destination).TrimEnd([char[]]'/\') + [IO.Path]::DirectorySeparatorChar
    $z = [IO.Compression.ZipFile]::OpenRead($Zip)
    $names = New-Object 'System.Collections.Generic.HashSet[string]' ([StringComparer]::OrdinalIgnoreCase)
    try {
        $total = 0L
        if ($z.Entries.Count -gt 2000) { throw 'Unexpected archive entry count.' }
        foreach ($e in $z.Entries) {
            $name = $e.FullName.Replace('\','/')
            if ($name.StartsWith('/') -or $name.Contains(':') -or $name -match '(^|/)\.\.(/|$)' -or $name.Contains([char]0)) { throw 'Unsafe archive path.' }
            if (-not $names.Add($name)) { throw 'Duplicate archive path.' }
            $kind = ($e.ExternalAttributes -shr 16) -band 61440
            if ($kind -eq 40960) { throw 'Archive symlinks are not allowed.' }
            $total += $e.Length
            if ($total -gt 1500000000 -or $e.Length -gt 400000000) { throw 'Unexpected expanded archive size.' }
            $target = [IO.Path]::GetFullPath((Join-Path $Destination $name))
            if (-not $target.StartsWith($root,[StringComparison]::OrdinalIgnoreCase)) { throw 'Archive path escaped the build directory.' }
            if ($e.Name.Length -eq 0) { [IO.Directory]::CreateDirectory($target) | Out-Null; continue }
            [IO.Directory]::CreateDirectory([IO.Path]::GetDirectoryName($target)) | Out-Null
            $inputStream = $e.Open()
            $outputStream = [IO.File]::Open($target,[IO.FileMode]::CreateNew)
            try { $inputStream.CopyTo($outputStream) }
            finally { $inputStream.Dispose(); $outputStream.Dispose() }
        }
    } finally { $z.Dispose() }
}
try {
    if ([Environment]::OSVersion.Platform -ne 'Win32NT') { throw 'Run START-WILDLIFE.cmd on your Windows Unreal computer.' }
    Write-Host 'Wildlife Reserve - build and open the Unreal district' -ForegroundColor Cyan
    Write-Host 'Uses your installed Unreal 5.7 and C++ build tools. No engine installation, account login, or remote-control agent.'
    Write-Host 'The district is an unfinished prototype. Building it does not fix the remaining material and gameplay work.'
    if ($KitUrl -notmatch '^https://wildlife-reserve-world-preview\.onrender\.com/unreal01/releases/[a-f0-9]{40}/Wildlife_Windows_Build_02\.zip$' -or $KitSha -notmatch '^[a-f0-9]{64}$') { throw 'Invalid release descriptor.' }
    $buildHome = Join-Path $env:LOCALAPPDATA 'GrindZone/WildlifeReserve'
    [IO.Directory]::CreateDirectory($buildHome) | Out-Null
    $downloadLock = [IO.File]::Open((Join-Path $buildHome 'launcher.lock'),[IO.FileMode]::OpenOrCreate,[IO.FileAccess]::ReadWrite,[IO.FileShare]::None)
    $archive = Join-Path $buildHome ($KitSha + '.zip')
    $valid = (Test-Path -LiteralPath $archive) -and ((Get-Item -LiteralPath $archive).Length -eq $KitBytes) -and ((Get-FileHash -LiteralPath $archive -Algorithm SHA256).Hash.ToLowerInvariant() -ceq $KitSha)
    if (-not $valid) {
        Write-Host 'Downloading the verified project and scene assets...'
        [Net.ServicePointManager]::SecurityProtocol = [Net.SecurityProtocolType]::Tls12
        $partial = $archive + '.' + [Guid]::NewGuid().ToString('N') + '.partial'
        $client = New-Object Net.WebClient
        $client.Headers.Add('User-Agent','WildlifeReserve-WindowsBuild/2')
        try { $client.DownloadFile($KitUrl,$partial) } finally { $client.Dispose() }
        if ((Get-Item -LiteralPath $partial).Length -ne $KitBytes -or (Get-FileHash -LiteralPath $partial -Algorithm SHA256).Hash.ToLowerInvariant() -cne $KitSha) { throw 'Download verification failed. No downloaded code was executed.' }
        if (Test-Path -LiteralPath $archive) { Move-Item -LiteralPath $archive -Destination ($archive + '.rejected-' + [Guid]::NewGuid().ToString('N')) }
        Move-Item -LiteralPath $partial -Destination $archive
    }
    $attempt = Join-Path $buildHome ('Build-' + (Get-Date -Format 'yyyyMMdd-HHmmss') + '-' + [Guid]::NewGuid().ToString('N').Substring(0,6))
    Write-Host 'Preparing an isolated build folder; existing Frontline files and game saves will not be edited.'
    Expand-WildlifeZip $archive $attempt
    $buildScript = Join-Path $attempt 'Build-Windows.ps1'
    if (-not (Test-Path -LiteralPath $buildScript)) { throw 'The verified archive has no build entry point.' }
    Write-Host "Build folder: $attempt"
    # RemoteSigned applies only to this child process. No machine/user policy is
    # written, and enforced organizational policy cannot be overridden here.
    & powershell.exe -NoLogo -NoProfile -ExecutionPolicy RemoteSigned -File $buildScript -Package -Play
    if ($LASTEXITCODE -ne 0) { throw "Build stopped. Local reports are in $attempt\BuildReports. No game-ready claim is made." }
    Write-Host "For subsequent launches use PLAY-WILDLIFE.cmd in $attempt" -ForegroundColor Green
    Start-Process explorer.exe -ArgumentList ('"' + $attempt + '"')
} catch {
    Write-Host "`nNOT COMPLETED: $($_.Exception.Message)" -ForegroundColor Red
    if ($attempt -and (Test-Path -LiteralPath $attempt)) {
        $_.Exception.Message | Set-Content -LiteralPath (Join-Path $attempt 'BUILD-STOPPED.txt') -Encoding UTF8
        Start-Process explorer.exe -ArgumentList ('"' + $attempt + '"')
    }
    exit 1
} finally { if ($downloadLock) { $downloadLock.Dispose() } }

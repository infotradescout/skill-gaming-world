; Engine configuration file.
; Generated and maintained as part of the Bay 13 playable runtime.

config_version=5

[application]

config/name="Robot Combat Prototype"
config/description="A local Robot Combat workshop, test bay, arena, and rebuild loop surfaced by Skill Gaming World."
run/main_scene="res://scenes/main.tscn"
boot_splash/image="res://assets/bay13-splash.png"
boot_splash/bg_color=Color(0.019, 0.035, 0.043, 1)
boot_splash/fullsize=false
boot_splash/use_filter=true

[display]

window/size/viewport_width=1440
window/size/viewport_height=810
window/size/window_width_override=1280
window/size/window_height_override=720
window/stretch/mode="canvas_items"

[physics]

common/physics_ticks_per_second=60
3d/default_gravity=18.0

[rendering]

renderer/rendering_method="gl_compatibility"
renderer/rendering_method.mobile="gl_compatibility"
textures/default_filters/use_nearest_mipmap_filter=false

[audio]

driver/enable_input=false

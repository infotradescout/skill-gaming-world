# Safe local mode. No real payment, prize, payout, deposit, or wager provider exists.
DEMO_MODE=true
SESSION_SECRET=replace-with-at-least-32-random-characters
COMPETITION_SEED_ENCRYPTION_KEY=replace-with-a-separate-at-least-32-character-key

# Required only when DEMO_MODE=false.
DATABASE_URL=postgresql://user:password@host/database?sslmode=require

# These must remain false until explicit legal, licensing, compliance, and merchant holds clear.
FEATURE_MONETAIRE_PRIZE=false
FEATURE_SOCIAL_CASINO=false
FEATURE_REAL_MONEY_CASINO=false
FEATURE_PRODUCTION_PAYMENTS=false

# Comma-separated ISO 3166-2 jurisdiction codes approved only for Monetaire Play.
MONETAIRE_PLAY_JURISDICTIONS=US
